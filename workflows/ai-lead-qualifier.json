        "url": "http://localhost:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama3.2', prompt: 'Score this inbound sales lead. Reply ONLY as JSON with keys: score (1-10 buying intent), category (string), summary (one sentence), reply (a short friendly first reply email).\\n\\nLead: ' + JSON.stringify($json.body), stream: false, format: 'json' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "9cbf86e9-9f50-4857-a856-9dd303bc9371",
      "name": "Score lead with local AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => {\n  let a = {};\n  try { a = JSON.parse(i.json.response); } catch (e) { a = { score: 0, summary: 'Could not parse', reply: '' }; }\n  const lead = $('New lead (form webhook)').first().json.body;\n  return { json: { ...a, score: Number(a.score) || 0, lead } };\n});"
      },
